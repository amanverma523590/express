<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyDataBase</title>
</head>
<body>
    <h1><%= result.length %></h1>
    <h1>Data will Be here</h1>
    <table border="1">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Age</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
              <% result.forEach(data=>{ %>
                <tr>
                  <td><%= data._Id  %></td>
                  <td><%= data.Name %></td>
                  <td><%= data.Symbol %></td>
                  <td><%= data.Address %></td>
                </tr>
              <% } ) %>  
        </tbody>
    </table>
</body>
</html>